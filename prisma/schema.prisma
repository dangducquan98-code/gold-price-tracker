generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GoldPriceHistory {
  id              String   @id @default(cuid())
  worldPriceUSD   Float    
  worldPriceVND   Float    
  exchangeRate    Float    

  // VN Prices
  sjcPrice        Float
  dojiPrice       Float
  btmcPrice       Float
  btmhPrice       Float

  // Differences (VND)
  sjcDiff         Float
  dojiDiff        Float
  btmcDiff        Float
  btmhDiff        Float

  // Differences (%)
  sjcDiffPct      Float
  dojiDiffPct     Float
  btmcDiffPct     Float
  btmhDiffPct     Float

  recordedAt      DateTime @default(now())
}
