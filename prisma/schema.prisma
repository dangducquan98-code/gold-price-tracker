generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GoldPriceHistory {
  id              String   @id @default(cuid())
  worldPriceUSD   Float    
  worldPriceVND   Float    
  vnPriceVND      Float    
  differenceVND   Float    
  exchangeRate    Float    
  recordedAt      DateTime @default(now())
}
